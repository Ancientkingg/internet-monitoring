{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"text": "Offline"}, "1": {"text": "Online"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "max(qbittorrent_up{server=~\"$server\"})", "refId": "A"}],
      "title": "qBittorrent status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"text": "Disconnected"}, "1": {"text": "Firewalled"}, "2": {"text": "Connected"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 2}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "max(qbittorrent_connected{server=~\"$server\"}) * 2 + max(qbittorrent_firewalled{server=~\"$server\"})", "refId": "A"}],
      "title": "Connection / firewall",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_total_peer_connections{server=~\"$server\"})", "refId": "A"}],
      "title": "Peer connections",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_torrents_count{server=~\"$server\"})", "refId": "A"}],
      "title": "Torrents",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_torrents_count{server=~\"$server\",status=~\"uploading|stalledUP|queuedUP|forcedUP\"})", "refId": "A"}],
      "title": "Seeding torrents",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_alltime_ul_total{server=~\"$server\"}) / clamp_min(sum(qbittorrent_alltime_dl_total{server=~\"$server\"}), 1)", "refId": "A"}],
      "title": "Share ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(rate(qbittorrent_dl_info_data_total{server=~\"$server\"}[2m]))", "legendFormat": "Download", "refId": "A"},
        {"expr": "sum(rate(qbittorrent_up_info_data_total{server=~\"$server\"}[2m]))", "legendFormat": "Upload", "refId": "B"}
      ],
      "title": "Transfer speed",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12},
      "id": 8,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_dl_info_data_total{server=~\"$server\"})", "refId": "A"}],
      "title": "Downloaded this session",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 12},
      "id": 9,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_up_info_data_total{server=~\"$server\"})", "refId": "A"}],
      "title": "Uploaded this session",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 12},
      "id": 10,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_alltime_dl_total{server=~\"$server\"})", "refId": "A"}],
      "title": "Downloaded all time",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "sum(qbittorrent_alltime_ul_total{server=~\"$server\"})", "refId": "A"}],
      "title": "Uploaded all time",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 12,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "showUnfilled": true},
      "targets": [{"expr": "sum by (status) (qbittorrent_torrents_count{server=~\"$server\"})", "instant": true, "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Torrents by status",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (status) (qbittorrent_torrents_count{server=~\"$server\",status=~\"uploading|stalledUP|queuedUP|forcedUP\"})", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Seeding activity",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["qbittorrent"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(qbittorrent_up, server)",
        "includeAll": true,
        "label": "Server",
        "multi": false,
        "name": "server",
        "query": {"query": "label_values(qbittorrent_up, server)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "qBittorrent",
  "uid": "qbittorrent-monitoring",
  "version": 1
}
